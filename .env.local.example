DATABASE_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
ALLOWED_EMAIL_DOMAIN=elastio.com
# Comma-separated; always admins, can't be removed from the UI
ADMIN_EMAILS=
# Optional locally: without Blob credentials, uploaded decks are stored in .data/.
# On Vercel, connecting a Blob store provides BLOB_STORE_ID (OIDC) or BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=
